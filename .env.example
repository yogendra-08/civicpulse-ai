# Supabase Configuration
# Get these values from your Supabase project settings at https://app.supabase.com

VITE_SUPABASE_URL=your-supabase-project-url
VITE_SUPABASE_ANON_KEY=your-supabase-anon-key

# Gemini API key for the floating chat assistant
VITE_GEMINI_API_KEY=AQ.Ab8RN6KEy-A5Lh7PkVx5QrIIbHJ-wX_E7QmdaSl-ncg-I9_pVg
# Optional Gemini model override
VITE_GEMINI_MODEL=gemini-1.5-flash

# Optional: Supabase Service Role Key (for admin operations - never expose to client)
# This should only be used in server-side code or admin scripts
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key

# Environment
VITE_ENV=development

# Application Configuration
VITE_APP_NAME=CivicPulse AI
VITE_MUNICIPALITY_NAME=Springfield

# Free AI model (optional)
# Set to true to try Hugging Face zero-shot classification before falling back to local rules.
VITE_USE_FREE_AI=true
VITE_HF_MODEL=facebook/bart-large-mnli
# Optional: only needed if your Hugging Face model requires a token.
VITE_HF_TOKEN=
